<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controlador.TaskDetailController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="topbar">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <StackPane style="-fx-background-color: #E6F1FB; -fx-background-radius: 15;" prefWidth="30" prefHeight="30">
                <Label text="R" style="-fx-text-fill: #185FA5; -fx-font-weight: bold;"/>
            </StackPane>
            <Label text="Remindly" styleClass="titulo-seccion"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Hyperlink text="Volver al panel" styleClass="link" onAction="#onVolver"/>
        </HBox>
    </top>

    <center>
        <VBox maxWidth="560" spacing="16">
            <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Region fx:id="barraPrioridad" prefWidth="6" prefHeight="28"/>
                <Label fx:id="labelTitulo" text="Entregar avance final" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="labelPrioridad" text="Prioridad alta" styleClass="badge-alta"/>
            </HBox>
            <Label fx:id="labelDescripcion" wrapText="true" styleClass="texto-secundario"
                   text="Preparar y subir la version final del proyecto."/>

            <HBox spacing="12">
                <VBox styleClass="superficie" spacing="4" HBox.hgrow="ALWAYS">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                    <Label text="Estado" styleClass="texto-secundario"/>
                    <Label fx:id="labelEstado" text="En progreso" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox styleClass="superficie" spacing="4" HBox.hgrow="ALWAYS">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                    <Label text="Tipo" styleClass="texto-secundario"/>
                    <Label fx:id="labelTipo" text="Tarea" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <Label text="Compartida con" styleClass="titulo-seccion"/>
            <VBox fx:id="cajaCompartidos" styleClass="tarjeta" spacing="6">
                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
            </VBox>

            <HBox spacing="8">
                <Button text="Editar" styleClass="boton-secundario" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onEditar"/>
                <Button text="Compartir" styleClass="boton-secundario" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onCompartir"/>
                <Button text="Eliminar" styleClass="boton-peligro" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onEliminar"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>