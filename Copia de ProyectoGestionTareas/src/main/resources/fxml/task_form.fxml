<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.controlador.TaskFormController"
           style="-fx-background-color: #F7F6F2;">

    <VBox styleClass="tarjeta" maxWidth="420" spacing="12">
        <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>

        <HBox alignment="CENTER_LEFT">
            <Label text="Nueva tarea" styleClass="titulo-seccion"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="X" styleClass="boton-secundario" onAction="#onCancelar"/>
        </HBox>

        <Label text="Titulo" styleClass="label-campo"/>
        <TextField fx:id="campoTitulo" promptText="Ej. Entregar avance final"/>

        <Label text="Descripcion" styleClass="label-campo"/>
        <TextArea fx:id="campoDescripcion" promptText="Detalles de la tarea" prefRowCount="2" wrapText="true"/>

        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Tipo" styleClass="label-campo"/>
                <ComboBox fx:id="comboTipo" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Estado" styleClass="label-campo"/>
                <ComboBox fx:id="comboEstado" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <Label text="Prioridad" styleClass="label-campo"/>
        <HBox spacing="8">
            <fx:define>
                <ToggleGroup fx:id="grupoPrioridad"/>
            </fx:define>
            <ToggleButton fx:id="botonAlta" text="Alta" toggleGroup="$grupoPrioridad" styleClass="boton-chip-seleccionado" selected="true" onAction="#onSeleccionarPrioridad"/>
            <ToggleButton fx:id="botonMedia" text="Media" toggleGroup="$grupoPrioridad" styleClass="boton-chip" onAction="#onSeleccionarPrioridad"/>
            <ToggleButton fx:id="botonBaja" text="Baja" toggleGroup="$grupoPrioridad" styleClass="boton-chip" onAction="#onSeleccionarPrioridad"/>
        </HBox>

        <Label text="Compartir con" styleClass="label-campo"/>
        <ComboBox fx:id="comboCompartirCon" promptText="Selecciona un usuario" maxWidth="Infinity"/>

        <Region prefHeight="6"/>
        <HBox spacing="8">
            <Button text="Cancelar" styleClass="boton-secundario" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onCancelar"/>
            <Button text="Guardar tarea" styleClass="boton-primario" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onGuardar"/>
        </HBox>
    </VBox>
</StackPane>